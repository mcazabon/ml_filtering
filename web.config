<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="PYTHONPATH" value="C:\SeaShell" />
    <add key="WSGI_HANDLER" value="wsgi.application" />
    <add key="FLASK_ENV" value="production" />
    <add key="FLASK_DEBUG" value="0" />
    <add key="FLASK_SECRET_KEY" value="replace-with-a-real-secret" />
  </appSettings>
  <system.webServer>
    <handlers>
      <add
        name="Python FastCGI"
        path="*"
        verb="*"
        modules="FastCgiModule"
        scriptProcessor="C:\SeaShell\.venv\Scripts\python.exe|C:\SeaShell\.venv\Lib\site-packages\wfastcgi.py"
        resourceType="Unspecified"
        requireAccess="Script"
      />
    </handlers>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>